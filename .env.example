# GitHub（可选；公开仓库可不填，有 Token 可提高限额 / 读私有仓）
GITHUB_TOKEN=

# LLM —— 兼容 OpenAI Chat Completions 的任意服务（也可用阿里云 DashScope 等）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 设为 1 时 Bot / Webhook 强制走本地模板，不调 LLM
GOSSIP_OFFLINE=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
# setWebhook 时的 secret_token；配置后 /api/telegram 会校验请求头
TELEGRAM_WEBHOOK_SECRET=

# 飞书
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# 部署
# 生产环境必填：保护 /api/gossip（Authorization: Bearer ... 或 x-webhook-secret）
WEBHOOK_SECRET=
