# GitHub（可选；公开仓库可不填，有 Token 可提高限额 / 读私有仓）
GITHUB_TOKEN=

# LLM —— 兼容 OpenAI Chat Completions 的任意服务（也可用阿里云 DashScope 等）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 单次 LLM 请求超时（毫秒；默认 20000）。超时后自动回落本地模板（mode=fallback）
LLM_TIMEOUT_MS=20000
# 单次出报最多拉取「提交详情（增删行/改动文件）」的 commit 数（默认 20）。
# 设为 0 则完全不拉详情，仅用列表级信息出报（调用数大幅降低）。
GOSSIP_MAX_COMMIT_DETAILS=20

# 设为 1 时 Bot / Webhook 强制走本地模板，不调 LLM
GOSSIP_OFFLINE=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
# setWebhook 时的 secret_token；配置后 /api/telegram 会校验请求头
TELEGRAM_WEBHOOK_SECRET=

# 飞书
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# 部署
# 可选：内部调用 /api/gossip 时用 Authorization: Bearer 或 x-webhook-secret
WEBHOOK_SECRET=
# 设为 1 时恢复旧行为：生产必须配置并校验 WEBHOOK_SECRET
GOSSIP_REQUIRE_WEBHOOK_SECRET=
# CORS：逗号分隔 Origin，或 *（默认）
GOSSIP_CORS_ORIGINS=
# 公开路径限流（每小时；进程内内存）
GOSSIP_RATE_LIMIT_IP_PER_HOUR=30
GOSSIP_RATE_LIMIT_REPO_PER_HOUR=60
# 徽章端点独立 IP 限流（每次缓存未命中要打 11-15 次 GitHub API）
GOSSIP_RATE_LIMIT_BADGE_PER_HOUR=60
# 八卦结果短时缓存（秒；0 关闭）
GOSSIP_CACHE_TTL_SEC=600
# Bot 每用户命令限速（每 10 分钟次数；0 不限）
GOSSIP_BOT_USER_RATE_LIMIT=12
