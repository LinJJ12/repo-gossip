{
  "name": "repo-gossip",
  "version": "0.1.0",
  "private": true,
  "description": "把仓库链接丢给 Bot，它不给你看枯燥的提交列表，而是给你整一份「项目八卦小报」。",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gossip": "npm run gossip -w @repo-gossip/core --",
    "bot": "npm run start -w @repo-gossip/bot",
    "web": "npm run dev -w @repo-gossip/web",
    "web:build": "npm run build -w @repo-gossip/web",
    "typecheck": "npm run typecheck -w @repo-gossip/core && npm run typecheck -w @repo-gossip/bot && npm run typecheck -w @repo-gossip/web",
    "test": "tsx --test test/*.test.ts",
    "build": "npm run build -w @repo-gossip/core"
  },
  "keywords": [
    "github",
    "bot",
    "discord",
    "telegram",
    "feishu",
    "llm",
    "gossip"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vercel/node": "^5.1.14",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
}
