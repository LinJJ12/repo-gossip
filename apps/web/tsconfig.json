{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@repo-gossip/core": ["../../packages/core/src/index.ts"],
      "@repo-gossip/core/github-links": ["../../packages/core/src/github-links.ts"]
    }
  },
  "include": ["src"]
}
